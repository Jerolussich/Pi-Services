[Unit]
# Corre el diagnostico cada hora y deja el resultado listo para tres lugares:
# el mensaje de bienvenida del SSH, el feed de eventos, y las metricas que
# levanta node-exporter para Grafana. Los avisos al celular salen de la misma
# corrida, solo cuando algo cambia de estado.
#
# __REPO__ y __USUARIO__ los reemplaza el instalador con los valores reales.
# Esta unidad NO se copia a mano: se instala con ./instalador.sh, que la
# escribe con la ruta donde clonaste el repo y el usuario que la corre.
Description=Estado de Pi-Services para el mensaje de bienvenida y las metricas
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=__USUARIO__
WorkingDirectory=__REPO__
# RuntimeDirectory crea /run/pi-services con el dueno correcto. Escribir
# directo en /run no se puede: es de root. Y va en /run y no en el disco
# porque es tmpfs: escribirlo cada hora en la microSD seria desgastar la
# tarjeta justamente con la herramienta que vigila que no se desgaste.
#
# La subcarpeta metrics es la que lee node-exporter. Va tambien en
# /etc/tmpfiles.d, para que exista al arrancar aunque el timer todavia no haya
# corrido: si no, Docker la crea el como root al montarla y despues este
# servicio no puede escribir adentro.
RuntimeDirectory=pi-services pi-services/metrics
RuntimeDirectoryPreserve=yes
ExecStart=/bin/bash -c '__REPO__/diagnostico.sh --breve --avisar > /run/pi-services/estado 2>&1; exit 0'
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=180
