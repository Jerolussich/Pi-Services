[Unit]
Description=Respaldo diario de Pi-Services

[Timer]
# A las 4 de la manana, cuando no hay nadie usando nada.
OnCalendar=*-*-* 04:00:00
# Si la Pi estaba apagada a esa hora, corre al prender. Un respaldo que se
# saltea en silencio porque el equipo estaba apagado no sirve de nada.
Persistent=true
# Un margen al azar para no arrancar junto con todo lo demas del sistema.
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
