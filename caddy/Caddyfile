{
    admin off
    auto_https off
}

# Log de acceso en un archivo de ruta fija del host, montado en el contenedor.
# Antes fail2ban leia el log JSON de Docker, cuya ruta incluye el ID del
# contenedor: cada vez que se recreaba Caddy, la ruta cambiaba y fail2ban
# quedaba apuntando a un archivo inexistente y no arrancaba.
#
# La rotacion la hace el propio Caddy, no logrotate, para no depender de un
# servicio externo que puede romperse sin avisar.
(accesslog) {
    log {
        output file /var/log/caddy/access.log {
            roll_size 20MiB
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
}

http://homepage.pi {
    import accesslog
    basic_auth {
        {$CADDY_USER} {$CADDY_PASSWORD_HASH}
    }
    reverse_proxy homepage:3000
}

http://grafana.pi {
    import accesslog
    reverse_proxy grafana:3000
}

http://wallabag.pi {
    import accesslog
    reverse_proxy wallabag:80
}

http://freshrss.pi {
    import accesslog
    reverse_proxy freshrss:80
}

http://news.pi {
    import accesslog
    reverse_proxy news-filter-ui:8084
}

http://finance.pi {
    import accesslog
    reverse_proxy finance-tracker-ui:8085
}

http://prometheus.pi {
    import accesslog
    basic_auth {
        {$CADDY_USER} {$CADDY_PASSWORD_HASH}
    }
    reverse_proxy prometheus:9090
}

# El feed de eventos. No hay contenedor detras: Caddy sirve una pagina
# estatica y el archivo de texto que escribe el diagnostico.
#
# Lleva autenticacion basica por el mismo criterio que homepage y prometheus:
# no trae login propio. Y como es un bloque http:// mas, su registro DNS sale
# solo del Caddyfile la proxima vez que corras el instalador.
http://eventos.pi {
    import accesslog
    basic_auth {
        {$CADDY_USER} {$CADDY_PASSWORD_HASH}
    }
    handle /feed.txt {
        root * /srv/datos
        rewrite * /eventos.log
        file_server
    }
    handle {
        root * /srv/site/eventos
        file_server
    }
}

http://pihole.pi {
    import accesslog
    redir / /admin/
    reverse_proxy 192.168.68.66:8181
}

# pi.hole es el nombre canonico que publica el propio Pi-hole y el que queda
# en los marcadores y en otros dispositivos. Sin este bloque cae en el catch
# all del final y responde 403, porque su interfaz ya no vive en el puerto 80.
http://pi.hole {
    import accesslog
    redir / /admin/
    reverse_proxy 192.168.68.66:8181
}

http://fitbit.pi {
    import accesslog
    reverse_proxy fitbit-exporter-ui:8086
}

# ── Stack multimedia (profile "media") ────────────────────────────────────
# Estas entradas responden 502 mientras el stack no este levantado, que es
# lo esperado si todavia no montaste el DAS.

http://jellyfin.pi {
    import accesslog
    reverse_proxy jellyfin:8096
}

# Radarr, Prowlarr, Bazarr y qBittorrent traen su propio login, asi que
# Caddy solo hace proxy. Mismo criterio que Grafana, Wallabag y FreshRSS.
http://radarr.pi {
    import accesslog
    reverse_proxy radarr:7878
}

http://sonarr.pi {
    import accesslog
    reverse_proxy sonarr:8989
}

# Seerr trae su propio login, asi que Caddy solo hace de proxy.
# Home Assistant corre en la red del host, asi que se proxea contra la IP y no
# contra un nombre de contenedor. Mismo caso que el panel de Pi-hole.
#
# Van dos nombres a proposito. El largo coincide con el nombre del contenedor,
# que es de donde el diagnostico deriva el puerto; el corto es el que vas a
# tipear en el celular. Los dos salen como registro DNS solos, porque cada uno
# es su propio bloque.
http://homeassistant.pi {
    import accesslog
    reverse_proxy 192.168.68.66:8123
}

http://casa.pi {
    import accesslog
    reverse_proxy 192.168.68.66:8123
}

http://seerr.pi {
    import accesslog
    reverse_proxy seerr:5055
}

http://prowlarr.pi {
    import accesslog
    reverse_proxy prowlarr:9696
}

http://bazarr.pi {
    import accesslog
    reverse_proxy bazarr:6767
}

http://qbit.pi {
    import accesslog
    reverse_proxy qbittorrent:8080
}

http:// {
    import accesslog

    # El score de salud, para el recuadro de la homepage.
    #
    # Va en el catch-all y no adentro de eventos.pi por una razon concreta: la
    # homepage lo pide como http://caddy/estado.json, o sea con el nombre del
    # contenedor como Host, y ese Host no coincide con ningun bloque y cae aca.
    #
    # Y va sin autenticacion porque el recuadro no sabe autenticarse. Es
    # aceptable: son un numero y un conteo, no hay nada publicado a internet,
    # y el resto del catch-all sigue respondiendo 403 como siempre.
    handle /estado.json {
        root * /srv/datos
        file_server
    }

    handle {
        respond "Access denied" 403
    }
}

# ── Configuracion generada ────────────────────────────────────────────────────
#
# Lo que el instalador escribe segun lo que encuentre en ESTA maquina, y que por
# eso no puede estar versionado aca. Hoy es un solo archivo: el bloque de HTTPS
# con el certificado de Tailscale, cuyo nombre de host es distinto en cada
# instalacion.
#
# El comodin no falla si no hay nada, asi que sin esos archivos Caddy levanta
# igual y esta linea no molesta.
import /etc/caddy/extra/*.caddy
