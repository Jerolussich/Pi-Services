# Usuario y grupo dueños de los archivos en el DAS.
# Los usan las imagenes de linuxserver (radarr, prowlarr, bazarr, qbittorrent).
# Obtenelos con: id -u && id -g
PUID=1000
PGID=1000

TZ=America/Montevideo

# Raiz del almacenamiento: el conjunto mergerfs de los dos discos.
# Ver DAS.md. Tiene que ser un unico montaje, si no se rompen los hardlinks.
DAS_ROOT=/mnt/das

# URL con la que Jellyfin se anuncia a los clientes.
#
# Va con la IP y el puerto, NO con jellyfin.pi. Es la direccion que el servidor
# le pasa a cada cliente para que vuelva a buscarlo, y las apps de tele y
# celular no resuelven los .pi: conectan por IP, el servidor les contesta
# "estoy en jellyfin.pi", y ahi se cortan.
#
# La IP cubre los dos casos. En la LAN es directa, y desde afuera tambien
# alcanza si en la consola de Tailscale esta aprobada la ruta de la LAN, que
# es la misma condicion que jellyfin.pi ya necesitaba para andar remoto.
# Ver TAILSCALE.md.
#
# El navegador sigue entrando por http://jellyfin.pi a traves de Caddy: esta
# variable no cambia por donde se entra, solo que direccion se les informa a
# los clientes.
JELLYFIN_PublishedServerUrl=http://192.168.68.66:8096

# Puerto de conexiones entrantes de qBittorrent.
# Es el unico puerto del stack que se publica al host.
QBIT_TORRENT_PORT=6881
