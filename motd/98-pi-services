#!/bin/sh
# Muestra el ultimo diagnostico al entrar por SSH, solo si hay algo mal.
#
# No corre el diagnostico aca: tarda unos segundos y nadie quiere esperar para
# ver un prompt. Lo deja listo el timer pi-estado, cada hora, en /run.
ESTADO=/run/pi-services/estado
[ -r "$ESTADO" ] || exit 0
[ -s "$ESTADO" ] || exit 0

# Si no hay ni un problema, no molesta.
if ! grep -q '◐\|✗' "$ESTADO" 2>/dev/null; then
    exit 0
fi

echo ""
printf '\033[1;33m  Pi-Services tiene cosas para mirar\033[0m\n'
# Solo los titulares, sin el detalle: para eso esta el comando completo.
grep '◐\|✗' "$ESTADO" 2>/dev/null | head -6
echo ""
printf '\033[0;90m  Detalle:  cd ~/pi-services && ./diagnostico.sh\033[0m\n'
echo ""
