        {
          "type": "table",
          "title": "Los chequeos, ahora",
          "description": "0 bien, 1 para mirar, 2 mal. Son los mismos que imprime ./diagnostico.sh: un solo lugar donde se decide que significa estar bien.",
          "gridPos": {
            "h": 12,
            "w": 10,
            "x": 0,
            "y": 9
          },
          "id": 401,
          "datasource": {
            "type": "prometheus",
            "uid": "afdfqn8b7ss1sf"
          },
          "targets": [
            {
              "refId": "A",
              "format": "table",
              "instant": true,
              "expr": "sort_desc(pi_check)",
              "datasource": {
                "type": "prometheus",
                "uid": "afdfqn8b7ss1sf"
              }
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
                  "__name__": true,
                  "instance": true,
                  "job": true
                },
                "renameByName": {
                  "nombre": "chequeo",
                  "capa": "capa",
                  "Value": "estado"
                }
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "bien",
                      "color": "green",
                      "index": 0
                    },
                    "1": {
                      "text": "para mirar",
                      "color": "orange",
                      "index": 1
                    },
                    "2": {
                      "text": "mal",
                      "color": "red",
                      "index": 2
                    }
                  }
                }
              ],
              "custom": {
                "cellOptions": {
                  "type": "color-text"
                }
              },
              "thresholds": {
